RewriteEngine On

# Everything is served out of the public folder, whichever folder of the site this one is.
# No RewriteBase is set, so the rewrite is counted from the folder this file sits in and
# the site works both as the document root and as a folder inside it. The lookahead keeps
# the rewritten path from being rewritten again.
RewriteRule ^(?!public/)(.*)$ public/$1 [L]
