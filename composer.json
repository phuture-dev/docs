{
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-zip": "*",
        "ext-tokenizer": "*",
        "popphp/popphp": "^v5.0.0",
        "latte/latte": "^v3.1.0",
        "league/commonmark": "^2.10",
        "league/climate": "^3.12",
        "milo/github-api": "^2.0",
        "tempest/highlight": "^2.28"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.92.0",
        "phpstan/phpstan": "^2.2",
        "nette/tester": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Phuture\\App\\": "app/"
        }
    },
    "scripts": {
        "lint": [
            "@phpcbf",
            "php-cs-fixer fix"
        ],
        "phpcbf": "phpcbf -n --standard=PSR12 app/ || true",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "tester": "tester tests -C",
        "test": ["@phpstan", "@tester", "php-cs-fixer fix --dry-run --diff"],
        "cron": "php bin/cron",
        "server": "php -S localhost:8000 -t public public/index.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
