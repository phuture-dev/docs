{layout 'structure.latte'}

{block content}
    <div class="py-5 text-center text-lg-start">
        <p class="text-body-secondary text-uppercase small fw-semibold mb-1">Error 404</p>

        <h1 class="display-6">{$heading}</h1>
        <p class="lead text-body-secondary">{$description}</p>

        <a class="btn btn-primary mt-3" href="/">
            <i class="bi bi-arrow-left"></i> Back to the documentation
        </a>
    </div>
{/block}
