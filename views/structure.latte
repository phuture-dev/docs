<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{$title} - {$app_name}</title>

        <link rel="stylesheet" href="{url('/assets/css/bootstrap.css')}">
        <link rel="stylesheet" href="{url('/assets/fonts/bootstrap-icons/bootstrap-icons.css')}">
        <link rel="stylesheet" href="{url('/assets/css/styles.css')}">

        <script src="{url('/assets/js/scripts.js')}"></script>
    </head>

    <body>
        <nav class="navbar navbar-expand-lg sticky-top bg-body-tertiary border-bottom" id="navbar">
            <div class="container-fluid px-lg-4">
                <button class="navbar-toggler border-0 me-2 d-lg-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#sidebar" aria-controls="sidebar" aria-expanded="false"
                    aria-label="Toggle documentation navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand d-flex align-items-center gap-2" href="{url('/')}">
                    <i class="bi bi-book"></i> {$app_name}
                </a>

                {**
                 * Answered by the search page on its own, and by the script with a list
                 * of suggestions under it where the browser can fetch them
                 *}
                <form class="docs-search ms-auto me-2" action="{url('/search')}" method="get" role="search" id="search">
                    <div class="docs-search-field">
                        <i class="bi bi-search docs-search-icon" aria-hidden="true"></i>

                        <input class="form-control" type="search" name="q" value="{$query ?? ''}"
                            placeholder="Search" aria-label="Search the documentation" id="search-input"
                            autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results"
                            aria-autocomplete="list">

                        <kbd class="docs-search-key" aria-hidden="true">/</kbd>
                    </div>

                    <div class="docs-search-suggestions" id="search-results" role="listbox" hidden></div>
                </form>

                <button class="theme-toggle btn border-0 d-flex align-items-center p-2 lh-1" type="button"
                    id="theme-toggle" aria-label="Switch to the light theme">
                    <i class="bi bi-sun-fill" aria-hidden="true"></i>
                </button>
            </div>
        </nav>

        <div class="container">
            <div class="row">
                <aside class="col-lg-4 col-xl-3 border-end px-lg-0">
                    <div class="docs-sidebar collapse d-lg-block py-3 px-lg-3" id="sidebar">
                        <div class="accordion accordion-flush">
                            {foreach $sidebar as $item}
                                {var $id = 'sidebar-group-' . $iterator->counter}

                                {if $item['children']}
                                    <div class="accordion-item bg-transparent border-0">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button bg-transparent shadow-none px-2 py-2 fw-semibold {if !$item['open']}collapsed{/if}"
                                                    type="button" data-bs-toggle="collapse" data-bs-target="#{$id}" aria-controls="{$id}"
                                                    aria-expanded="{if $item['open']}true{else}false{/if}">
                                                {$item['label']}
                                            </button>
                                        </h2>

                                        <div class="accordion-collapse collapse {if $item['open']}show{/if}" id="{$id}">
                                            <div class="accordion-body p-0 pb-2">
                                                {include links, items: $item['children'], prefix: $id}
                                            </div>
                                        </div>
                                    </div>
                                {else}
                                    <div class="accordion-item bg-transparent border-0">
                                        {include links, items: [$item], prefix: $id}
                                    </div>
                                {/if}
                            {/foreach}
                        </div>
                    </div>
                </aside>

                <main class="docs-content col-lg-8 col-xl-7 py-4 p-lg-5">
                    {block content}{/block}
                </main>

                {**
                 * Filled in by scripts.js with the table of contents the page carries, when it has one
                 *}
                <aside class="docs-toc col-xl-2" id="toc"></aside>
            </div>
        </div>

        <script src="{url('/assets/js/popper.js')}"></script>
        <script src="{url('/assets/js/bootstrap.js')}"></script>
    </body>
</html>

{**
 * Navigation links, nested as deep as the markdown goes
 *
 * Every entry holding children folds away behind its own toggle, and is left
 * open when the page being served sits somewhere inside it.
 *}
{define links, array $items, string $prefix}
    <ul class="nav flex-column">
        {foreach $items as $item}
            {var $id = $prefix . '-' . $iterator->counter}

            <li class="nav-item">
                <div class="d-flex align-items-center">
                    <a class="nav-link flex-grow-1 px-2 py-1 {if $item['active']}active fw-semibold{else}link-body-emphasis{/if}"
                        href="{$item['url']}" n:attr="aria-current: $item['active'] ? 'page'">
                        {$item['label']}
                    </a>

                    {if $item['children']}
                        <button class="sidebar-toggle btn border-0 p-1 lh-1 {if !$item['open']}collapsed{/if}"
                            type="button" data-bs-toggle="collapse" data-bs-target="#{$id}" aria-controls="{$id}"
                            aria-expanded="{if $item['open']}true{else}false{/if}"
                            aria-label="Toggle the {$item['label']} section">
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                    {/if}
                </div>

                {if $item['children']}
                    <div class="collapse ms-3 {if $item['open']}show{/if}" id="{$id}">
                        {include links, items: $item['children'], prefix: $id}
                    </div>
                {/if}
            </li>
        {/foreach}
    </ul>
{/define}
